---
import { getLangFromUrl } from "../i18n/utils";

interface Props {
  lang?: "en" | "zh";
}

const lang = Astro.props.lang || getLangFromUrl(Astro.url);

interface Review {
  quote: string;
  author: string;
  role: string;
}

const content = {
  en: [
    {
      quote:
        "I manage 3 Shopify stores in different languages. This extension saves me hours every week — no more copy-pasting into Google Translate. Everything stays right in the Shopify admin.",
      author: "Marcus W.",
      role: "Store Owner",
    },
    {
      quote:
        "The translations are surprisingly good for product descriptions. I still review them, but it gets me 90% there instantly.",
      author: "Sarah C.",
      role: "E-commerce Manager",
    },
    {
      quote:
        "Simple and does exactly what it says. Click the button, get the translation. Works well with Translate & Adapt.",
      author: "David M.",
      role: "E-commerce Manager",
    },
  ],
  zh: [
    {
      quote:
        "我管理3个不同语言的Shopify商店。这个扩展每周能帮我省好几个小时——再也不用复制粘贴到翻译工具了。所有操作都在Shopify后台完成。",
      author: "Marcus W.",
      role: "店主",
    },
    {
      quote:
        "产品描述的翻译质量出乎意料地好。我还是会检查一遍，但它能让我瞬间完成90%的工作。",
      author: "Sarah C.",
      role: "电商运营",
    },
    {
      quote:
        "简单实用，功能如其所述。点击按钮，获得翻译。和Translate & Adapt配合良好。",
      author: "David M.",
      role: "电商运营",
    },
  ],
};

const reviews: Review[] = content[lang];
---

<section class="reviews-section" id="reviews">
  <div class="reviews-container">
    <div class="reviews-carousel">
      <button type="button" class="review-arrow" data-review-prev aria-label={lang === "zh" ? "上一条评价" : "Previous review"}>
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m14 5-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
    <div class="reviews-content">
      {
        reviews.map((review, index) => (
          <div
            class={`review-slide ${index === 0 ? "active" : ""}`}
            data-index={index}
          >
            <blockquote class="review-quote">
              <span class="quote-mark">"</span>
              {review.quote}
              <span class="quote-mark">"</span>
            </blockquote>
            <div class="review-author">
              <span class="author-name">{review.author}</span>
              <span class="author-role">{review.role}</span>
            </div>
          </div>
        ))
      }
    </div>

      <button type="button" class="review-arrow" data-review-next aria-label={lang === "zh" ? "下一条评价" : "Next review"}>
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m10 5 7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
    </div>
    <div class="reviews-nav">
      {
        reviews.map((_, index) => (
          <button
            class={`nav-indicator ${index === 0 ? "active" : ""}`}
            data-index={index}
            aria-label={`View review ${index + 1}`}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .reviews-section {
    background-color: #000000;
    padding: var(--section-spacing) 0;
  }

  .reviews-container {
    max-width: calc(var(--page-width) + 48px);
    margin: 0 auto;
    padding: 0 24px;
  }

  .reviews-carousel { display: grid; grid-template-columns: 44px minmax(0, 1fr) 44px; gap: 24px; align-items: center; }
  .review-arrow { display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: none; border-radius: 50%; color: #fff; background: transparent; cursor: pointer; transition: background-color .2s; }
  .review-arrow:hover { background: rgba(255,255,255,.15); }
  .review-arrow:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }
  @media (prefers-reduced-motion: reduce) { .review-slide, .review-arrow { transition: none; } }
  .reviews-content {
    position: relative;
    min-height: 280px;
  }

  .review-slide {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.4s ease,
      visibility 0.4s ease;
    text-align: center;
  }

  .review-slide.active {
    position: relative;
    opacity: 1;
    visibility: visible;
  }

  .review-quote {
    font-family: var(--font-heading);
    font-size: clamp(24px, 4vw, 36px);
    font-weight: 400;
    line-height: 1.4;
    color: #ffffff;
    margin: 0 0 32px;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  .quote-mark {
    color: #ffffff;
  }

  .review-author {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .author-name {
    font-size: 16px;
    font-weight: 500;
    color: #ffffff;
  }

  .author-role {
    font-size: 16px;
    color: rgba(255, 255, 255, 0.6);
  }

  .reviews-nav {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 48px;
  }

  .nav-indicator {
    position: relative;
    width: 48px;
    height: 4px;
    background-color: rgba(255, 255, 255, 0.3);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.3s ease;
  }

  .nav-indicator::before {
    content: "";
    position: absolute;
    top: -12px;
    bottom: -12px;
    left: 0;
    right: 0;
  }

  .nav-indicator:hover {
    background-color: rgba(255, 255, 255, 0.5);
  }

  .nav-indicator.active {
    background-color: #ffffff;
  }

  @media (max-width: 768px) {
    .reviews-carousel { grid-template-columns: 36px minmax(0, 1fr) 36px; gap: 8px; }
    .review-arrow { width: 36px; height: 36px; }
    .reviews-container {
      padding: 0 16px;
    }

    .reviews-content {
      min-height: auto;
    }

    .review-quote {
      font-size: 20px;
      margin-bottom: 24px;
    }

    .review-author {
      flex-direction: column;
      gap: 4px;
    }

    .author-name,
    .author-role {
      font-size: 14px;
    }

    .reviews-nav {
      margin-top: 32px;
    }

    .nav-indicator {
      width: 40px;
    }
  }
</style>

<script>
  function setupReviews() {
    document.querySelectorAll<HTMLElement>('.reviews-section').forEach((section) => {
      if (section.dataset.initialized) return;
      section.dataset.initialized = 'true';
      const slides = Array.from(section.querySelectorAll<HTMLElement>('.review-slide'));
      const indicators = Array.from(section.querySelectorAll<HTMLButtonElement>('.nav-indicator'));
      let current = 0;
      function select(index: number) {
        current = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          slide.classList.toggle('active', i === current);
          slide.setAttribute('aria-hidden', String(i !== current));
        });
        indicators.forEach((indicator, i) => {
          indicator.classList.toggle('active', i === current);
          indicator.setAttribute('aria-current', String(i === current));
        });
      }
      indicators.forEach((indicator, index) => indicator.addEventListener('click', () => select(index)));
      section.querySelector('[data-review-prev]')?.addEventListener('click', () => select(current - 1));
      section.querySelector('[data-review-next]')?.addEventListener('click', () => select(current + 1));
      select(0);
    });
  }
  setupReviews();
  document.addEventListener('astro:page-load', setupReviews);
</script>
