---
import BrowserDownload from "./BrowserDownload.astro";
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  lang?: 'en' | 'zh';
}

const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="cta-section">
  <div class="cta-container">
    <div class="cta-card">
      <h2 class="cta-title">{t('cta.title')}</h2>
      <BrowserDownload lang={lang} id="cta" variant="white" />
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: 32px 0;
    background-color: var(--color-background);
  }
  
  .cta-container {
    max-width: calc(var(--page-width) + 48px);
    margin: 0 auto;
    padding: 0 24px;
  }
  
  .cta-card {
    background-color: #32a8ff;
    border-radius: 16px;
    padding: 64px 40px;
    text-align: center;
  }
  
  .cta-title {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 400;
    color: #ffffff;
    margin-bottom: 32px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.2;
  }
  
  @media (max-width: 768px) {
    .cta-section { padding: 20px 0; }
    .cta-container {
      padding: 0 16px;
    }
    
    .cta-card {
      padding: 48px 24px;
      border-radius: 12px;
    }
    
    .cta-title {
      margin-bottom: 24px;
    }
    

  }
</style>
