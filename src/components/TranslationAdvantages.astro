---
import advantagesIcon from '../assets/translation-advantages-icon.svg';
interface Props { lang?: 'en' | 'zh'; }
const { lang = 'en' } = Astro.props;
const copy = {
  en: { title: 'Why choose Yahao over other Shopify App Store translation apps?', description: "Keep translating in Shopify’s own Translate & Adapt interface, with your original content and translations side by side. There’s no separate translation dashboard to learn or switch to. Yahao adds AI translation to this familiar workflow, so you can translate, review and edit in one place, with fewer extra integration steps to manage." },
  zh: { title: '相比 Shopify App Store 的其他翻译应用，有何优势？', description: '直接在 Shopify 官方的 Translate & Adapt 中完成翻译，原文与译文并排展示，检查和修改都更顺手。无需学习另一套翻译后台，也不用在多个应用之间来回切换。Yahao 将 AI 翻译融入你熟悉的操作流程，让翻译、校对和编辑集中在同一个界面，减少独立翻译系统带来的额外适配环节。' },
}[lang];
---
<section class="translation-advantages" aria-labelledby="advantages-title">
  <div class="advantages-content">
    <img class="advantages-icon" src={advantagesIcon.src} width="48" height="48" alt="" />
    <h2 id="advantages-title">{copy.title}</h2>
    <p>{copy.description}</p>
  </div>
</section>
<style>
  .translation-advantages { padding: 0 24px 40px; }
  .advantages-content { max-width: var(--page-width); margin: 0 auto; padding: 48px; border-radius: 20px; background: #f7f8f9; text-align: center; }
  .advantages-icon { width: 48px; height: 48px; margin: 0 auto 20px; }
  h2 { font-family: var(--font-heading); font-size: clamp(1.75rem, 1.25rem + 1.5vw, 2.25rem); font-weight: 500; letter-spacing: -.025em; margin-bottom: 20px; }
  p { max-width: 820px; margin: 0 auto; font-size: 18px; line-height: 1.8; color: #555; }
  @media (max-width: 768px) {
    .translation-advantages { padding: 0 16px 24px; }
    .advantages-content { padding: 28px 20px; border-radius: 16px; }
    p { font-size: 16px; line-height: 1.75; }
  }
</style>
