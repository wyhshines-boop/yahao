---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import BrowserDownload from "./BrowserDownload.astro";
import HeroDemo from "./HeroDemo.astro";
import translateAdapt from "../assets/translate-adapt.webp";

interface Props {
  lang?: "en" | "zh";
}

const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="hero">
  <div class="hero-container">
    <div class="hero-heading">
      <h1 class="hero-title">
        <span class="hero-title-main">{t("hero.title")}</span>
        <span class="hero-title-product">
          <span class="hero-connector">{t("hero.connector")}</span>
          <img src={translateAdapt.src} width={translateAdapt.width} height={translateAdapt.height} alt="" class="product-icon" />
          <span>Shopify Translate &amp; Adapt</span>
        </span>
      </h1>
      <BrowserDownload lang={lang} id="hero" />

    </div>
    <HeroDemo lang={lang} />
  </div>
</section>

<style>
  .hero {
    padding: 112px 24px 64px;
    background: var(--color-background);
  }

  .hero-container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 40px 24px 24px;
    background: #f7f8f9;
    border-radius: 24px;
  }

  .hero-heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 44px;
  }

  .hero-title {
    max-width: 100%;
    font-family: var(--font-heading);
    color: #151a20;
  }

  .hero-title-main {
    display: block;
    font-size: clamp(2.25rem, 1.25rem + 3.5vw, 4rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .hero-title-product {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
    font-family: var(--font-body);
    font-size: clamp(1.125rem, 0.75rem + 1.6vw, 1.875rem);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.035em;
    color: #3e4752;
  }

  .hero-connector {
    color: #7a838c;
    font-weight: 400;
    margin-right: 2px;
  }

  .product-icon {
    width: 32px;
    height: 32px;
    border-radius: 7px;
    flex-shrink: 0;
  }

  .hero-heading :global(.hero-downloads) { margin-top: 28px; }

  @media (max-width: 768px) {
    .hero {
      padding: 88px 16px 40px;
    }

    .hero-container {
      padding: 24px 16px 16px;
      border-radius: 20px;
    }

    .hero-heading {
      margin-bottom: 32px;
    }

    .hero-title {
      width: 100%;
    }

    .hero-title-product {
      gap: 6px;
      margin-top: 16px;
      font-size: clamp(1rem, 0.5rem + 2.6vw, 1.5rem);
      letter-spacing: -0.04em;
    }

    .product-icon {
      width: 24px;
      height: 24px;
      border-radius: 5px;
    }

    .hero-heading :global(.hero-downloads) { margin-top: 24px; }

  }
</style>
