---
interface Props {
  title: string;
  description: string;
  image: ImageMetadata;
  mediaAlt: string;
  layout?: 'left' | 'right';
}

const { title, description, image, mediaAlt, layout = 'left' } = Astro.props;
---

<section class="image-with-text">
  <div class:list={['iwt-container', `layout-${layout}`]}>
    <div class="iwt-media">
      <img
        src={image.src}
        width={image.width}
        height={image.height}
        alt={mediaAlt}
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="iwt-content">
      <h2 class="iwt-title">{title}</h2>
      <p class="iwt-description">{description}</p>
    </div>
  </div>
</section>

<style>
  .image-with-text {
    padding: 24px;
  }

  .iwt-container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 48px;
    background-color: #f2f9ff;
    border-radius: 20px;
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 48px;
    align-items: center;
  }

  .layout-right.iwt-container {
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
  }

  .layout-right .iwt-media {
    order: 2;
  }

  .layout-right .iwt-content {
    order: 1;
  }

  .iwt-media img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 12px;
  }

  .iwt-content {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .iwt-title {
    font-family: var(--font-heading);
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 400;
    line-height: 1.2;
    color: var(--color-text-dark);
  }

  .iwt-description {
    font-size: 18px;
    line-height: 1.6;
    color: var(--color-text-dark);
    max-width: 400px;
  }

  @media (max-width: 768px) {
    .image-with-text {
      padding: 16px;
    }

    .iwt-container,
    .layout-right.iwt-container {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      padding: 24px;
      border-radius: 16px;
    }

    .iwt-media,
    .layout-right .iwt-media {
      order: 1;
    }

    .iwt-content,
    .layout-right .iwt-content {
      order: 2;
    }

    .iwt-title {
      font-size: 28px;
    }

    .iwt-description {
      font-size: 16px;
      max-width: 100%;
    }
  }
</style>
