---
import { useTranslations } from '../i18n/utils';
interface Props { lang: 'en' | 'zh'; }
const t = useTranslations(Astro.props.lang);
---
<div class="free-benefits">
  <span class="benefit-check" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 28 28" fill="none">
      <path d="m6 14 5 5L22 8" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </span>
  <p><span>{t('hero.free')}</span><span>{t('hero.stores')}</span></p>
</div>
<style>
  .free-benefits {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px 8px 8px;
    border-radius: 999px;
    background: #e1f4ff;
    color: #000;
    flex-shrink: 0;
  }
  .benefit-check {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: #28aaf3;
    color: #fff;
    flex-shrink: 0;
  }
  p { display: flex; align-items: center; gap: 16px; font-size: 13px; font-weight: 600; line-height: 1.4; }
  @media (max-width: 1050px) {
    p { flex-direction: column; align-items: flex-start; gap: 1px; font-size: 12px; }
  }
</style>
