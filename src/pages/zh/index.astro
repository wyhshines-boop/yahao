---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Hero from "../../components/Hero.astro";
import ProductIntro from "../../components/ProductIntro.astro";
import ImageWithText from "../../components/ImageWithText.astro";
import formatting from "../../assets/preserve-formatting.webp";
import speed from "../../assets/fast-translation.webp";
import controls from "../../assets/translation-controls.webp";
import FeaturesGrid from "../../components/FeaturesGrid.astro";
import Reviews from "../../components/Reviews.astro";
import Pricing from "../../components/Pricing.astro";
import FAQ from "../../components/FAQ.astro";
import CTACard from "../../components/CTACard.astro";
import Footer from "../../components/Footer.astro";

const lang = "zh";
---

<Layout currentPage="home" lang={lang}>
  <Header currentPage="home" lang={lang} />
  <main>
    <Hero lang={lang} />
    <ProductIntro lang={lang} />

    <ImageWithText
      title="完整保留格式与布局"
      description="粗体、链接、颜色、表格和图片，100% 完整保留"
      image={formatting}
      mediaAlt="英文与德文内容对照，完整保留粗体、链接、颜色、表格和商品图片"
      layout="left"
    />

    <ImageWithText
      title="快速、精准的 AI 翻译"
      description="由专为电商打造的 AI 模型驱动"
      image={speed}
      mediaAlt="自动翻译完成，支持 90 多种语言及快速、均衡和精准模式"
      layout="right"
    />

    <ImageWithText
      title="一切尽在掌握"
      description="自定义术语表、品牌语气与翻译设置"
      image={controls}
      mediaAlt="Yahao Translate 的术语表、品牌语气、翻译模式和行业设置"
      layout="left"
    />

    <FeaturesGrid lang={lang} />

    <Reviews lang={lang} />

    <Pricing lang={lang} />

    <FAQ lang={lang} />

    <CTACard lang={lang} />
  </main>

  <Footer lang={lang} />
</Layout>
